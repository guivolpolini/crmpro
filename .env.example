# ==============================================================================
# CRM PRO — Environment Variables Example
# ==============================================================================

# Database Configuration (PostgreSQL 16)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/crmpro_db
SPRING_DATASOURCE_USERNAME=crmpro_user
SPRING_DATASOURCE_PASSWORD=crmpro_password

# JWT Security
JWT_SECRET=4c9b986b245cfbc1865910fae7401f81d11ffbe81db577a45638a165eb340801
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Server
PORT=8080

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# FreeLLMAPI (Fallback IA Global)
OPENAI_BASE_URL=http://localhost:3001/v1
OPENAI_API_KEY=your_freellmapi_key_here
